{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "P=python3; python3 -V >/dev/null 2>&1 || P=python; \"$P\" \"${CLAUDE_PLUGIN_ROOT}/skills/jira-sync/jira_sync.py\" check-commit",
            "timeout": 30
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/skills/jira-sync/jira_sync.py\" link-pr --if-gh-pr-create || python \"${CLAUDE_PLUGIN_ROOT}/skills/jira-sync/jira_sync.py\" link-pr --if-gh-pr-create",
            "timeout": 30
          }
        ]
      },
      {
        "matcher": "ExitPlanMode",
        "hooks": [
          {
            "type": "command",
            "command": "P=python3; python3 -V >/dev/null 2>&1 || P=python; \"$P\" \"${CLAUDE_PLUGIN_ROOT}/skills/jira-sync/jira_sync.py\" plan-approved",
            "timeout": 30
          }
        ]
      }
    ]
  }
}
